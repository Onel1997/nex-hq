# Active workspace — must match a slug in brain/workspaces/registry.ts
NEXHQ_WORKSPACE_SLUG=milaene
NEXT_PUBLIC_NEXHQ_WORKSPACE_SLUG=milaene
# Comma-separated Supabase auth user UUIDs authorized for Persona Studio in
# the server-selected workspace. Required for production Persona access.
NEXHQ_PERSONA_AUTHORIZED_USER_IDS=
# Explicit local-only bypass. Ignored in production; never production auth.
NEXHQ_PERSONA_DEV_AUTH_BYPASS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Xeriamo Stripe billing. Billing fails closed unless the mode is explicit.
# Test/staging: use only sk_test_*, cs_test_*, livemode=false, and test Prices.
# Live remains disabled until every server gate below is independently ready.
XERIAMO_STRIPE_MODE=test
XERIAMO_LIVE_BILLING_ENABLED=false
NEXT_PUBLIC_APP_URL=https://staging.example.invalid
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
XERIAMO_STRIPE_PORTAL_CANCELLATION_ONLY=false
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_TOP_UP_250=
STRIPE_PRICE_TOP_UP_500=
STRIPE_PRICE_TOP_UP_1000=
STRIPE_PRICE_TOP_UP_2500=

# Live-only allowlist/readiness gates. Do not set true or add reviewed version
# identifiers until Stripe Tax, merchant data, and external legal review are complete.
XERIAMO_LIVE_APP_ORIGIN=https://xeriamo.com
XERIAMO_LIVE_SUPABASE_PROJECT_REF=
XERIAMO_LIVE_LEGAL_READY=false
XERIAMO_LIVE_TERMS_VERSION=
XERIAMO_LIVE_PRIVACY_VERSION=
XERIAMO_LIVE_REFUND_POLICY_VERSION=
XERIAMO_LIVE_MERCHANT_DETAILS_READY=false
XERIAMO_LIVE_MERCHANT_COUNTRY=
XERIAMO_LIVE_TAX_READY=false

# OpenAI
OPENAI_API_KEY=

# Defense-in-depth only. Keep false: Image Studio still lacks a durable,
# per-attempt paid confirmation/idempotent job boundary.
NEXHQ_IMAGE_PAID_GENERATION_ENABLED=false
# Required before paid Image job preparation. Conservative maximum USD allowance
# for two high-fidelity provider image inputs; not a provider credential.
NEXHQ_OPENAI_IMAGE_INPUT_COST_MAX_USD=

# Official Brand Face discovery provider (Phase 2.5A default: openai)
# PERSONA_DISCOVERY_PROVIDER=openai
# Optional explicit FLUX casting only:
# PERSONA_DISCOVERY_PROVIDER=fal_flux
# FAL_KEY=

# CEO orchestration — auto-run research/designer/marketing on task assignment
AUTO_EXECUTION_ENABLED=true
